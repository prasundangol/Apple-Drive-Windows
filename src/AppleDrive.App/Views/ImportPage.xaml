<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppleDrive.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:AppleDrive.Presentation.Resources">

    <StackPanel MaxWidth="960" Padding="32,24,32,32" Spacing="16">
        <TextBlock
            Style="{StaticResource PageTitleStyle}"
            Text="{x:Bind res:Strings.NavImport}"
            AutomationProperties.HeadingLevel="Level1" />
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind res:Strings.ImportEmptyTitle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind res:Strings.ImportEmptyBody}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppleDrive.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:AppleDrive.Presentation.Resources">

    <Grid>
        <StackPanel
            MaxWidth="520"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <FontIcon
                HorizontalAlignment="Left"
                FontSize="48"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE8EA;"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Text="{x:Bind res:Strings.WelcomeTitle}"
                TextWrapping="WrapWholeWords"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock
                Style="{StaticResource BodyLargeTextBlockStyle}"
                Text="{x:Bind res:Strings.WelcomeBody}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind res:Strings.WelcomeConnectHint}"
                TextWrapping="WrapWholeWords" />
            <Button
                x:Name="GetStartedButton"
                Margin="0,8,0,0"
                Command="{x:Bind ViewModel.GetStartedCommand}"
                Content="{x:Bind res:Strings.WelcomeGetStarted}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppleDrive.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:AppleDrive.Presentation.Resources">

    <ScrollViewer>
        <StackPanel
            MaxWidth="960"
            Padding="32,24,32,32"
            Spacing="12">
            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Text="{x:Bind res:Strings.SettingsTitle}"
                AutomationProperties.HeadingLevel="Level1" />

            <!-- Destination -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind res:Strings.DestinationHeader}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="{x:Bind res:Strings.DestinationDescription}" TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Margin="0,6,0,0"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DestinationFolder, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.BrowseDestinationCommand}"
                        Content="{x:Bind res:Strings.Browse}"
                        AutomationProperties.Name="{x:Bind res:Strings.DestinationHeader}" />
                </Grid>
            </Border>

            <!-- Organization -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind res:Strings.OrganizationHeader}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="{x:Bind res:Strings.OrganizationDescription}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="280"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.OrganizationChoices}"
                        SelectedItem="{x:Bind ViewModel.SelectedOrganization, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Bind res:Strings.OrganizationHeader}" />
                </Grid>
            </Border>

            <!-- Duplicates -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind res:Strings.SkipDuplicatesHeader}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="{x:Bind res:Strings.SkipDuplicatesDescription}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.SkipExactDuplicates, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Bind res:Strings.SkipDuplicatesHeader}" />
                </Grid>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind res:Strings.LogLevelHeader}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="{x:Bind res:Strings.LogLevelDescription}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.LogLevelChoices}"
                        SelectedItem="{x:Bind ViewModel.SelectedLogLevel, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Bind res:Strings.LogLevelHeader}" />
                    <HyperlinkButton
                        Grid.Row="1"
                        Padding="0"
                        Command="{x:Bind ViewModel.OpenLogsFolderCommand}"
                        Content="{x:Bind res:Strings.OpenLogsFolder}" />
                </Grid>
            </Border>

            <!-- Privacy and about -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind res:Strings.PrivacyHeader}" />
                        <TextBlock Text="{x:Bind res:Strings.PrivacyBody}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind res:Strings.AboutHeader}" />
                        <TextBlock Text="{x:Bind res:Strings.AppTitle}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="{x:Bind ViewModel.Version}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

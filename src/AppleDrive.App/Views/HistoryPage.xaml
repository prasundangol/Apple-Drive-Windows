<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppleDrive.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppleDrive.App.Views"
    xmlns:res="using:AppleDrive.Presentation.Resources"
    xmlns:vm="using:AppleDrive.Presentation.ViewModels">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Style="{StaticResource PageTitleStyle}"
            Text="{x:Bind res:Strings.NavHistory}"
            AutomationProperties.HeadingLevel="Level1" />

        <StackPanel Grid.Row="1" Spacing="12">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Warning" />
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasNoSessions, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind res:Strings.HistoryEmptyTitle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind res:Strings.HistoryEmptyBody}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid
            Grid.Row="2"
            ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Runs, newest first -->
            <ListView
                ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=OneWay}"
                SelectionChanged="OnSessionSelected"
                SelectionMode="Single"
                AutomationProperties.Name="{x:Bind res:Strings.NavHistory}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistorySessionViewModel">
                        <StackPanel Padding="0,8" Spacing="2" AutomationProperties.Name="{x:Bind AccessibleName}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="{x:Bind StatusGlyph}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DateText}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind local:Previews.Pair(StatusText, DeviceText)}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SummaryText}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Files of the selected run -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind res:Strings.HistoryFilesHeader}"
                                AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.FilesSummary, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.OpenDestinationCommand}"
                            Content="{x:Bind res:Strings.OpenFolder}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind res:Strings.HistoryFilesNote}"
                        TextWrapping="WrapWholeWords" />
                    <ListView
                        Grid.Row="2"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                        SelectionMode="None"
                        AutomationProperties.Name="{x:Bind res:Strings.HistoryFilesHeader}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryFileViewModel">
                                <Grid Padding="0,6" ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Margin="0,2,0,0"
                                        VerticalAlignment="Top"
                                        FontSize="14"
                                        Glyph="{x:Bind StatusGlyph}"
                                        AutomationProperties.AccessibilityView="Raw" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind FileName}" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StatusText}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DetailText}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind HasDetail}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

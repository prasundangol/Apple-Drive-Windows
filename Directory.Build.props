<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Product>Apple Drive</Product>
    <Authors>Prasun Dangol</Authors>
    <Company>Prasun Dangol</Company>
    <Copyright>Copyright © 2026 Prasun Dangol</Copyright>
    <Version>0.1.0</Version>

    <!-- Shared Windows target for projects that need WinRT / Win32 APIs. -->
    <AppleDriveWindowsTfm>net10.0-windows10.0.26100.0</AppleDriveWindowsTfm>
    <AppleDriveMinWindows>10.0.19041.0</AppleDriveMinWindows>
  </PropertyGroup>
</Project>
